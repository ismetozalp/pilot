node_modules/
*.log
docs/

# Vendor bundles fetched by `make vendor` — third-party, not committed.
/js/alpine.min.js
/js/bootstrap.bundle.min.js
/css/bootstrap.min.css

# Build artifact from `make zip`.
/pilot-*.zip

# Screenshots written by tests/e2e.mjs's shot().
/tests/e2e-*.png

# Python bytecode left by running libexec/pilot-exec (the integration tier runs
# it directly). Both `make install` and `make zip` also strip it, so it can
# never reach a release artifact, but it must not be committed either.
libexec/__pycache__/
*.pyc

# Scratch directory written by the Chrome DevTools / Playwright MCP tooling.
.playwright-mcp/
